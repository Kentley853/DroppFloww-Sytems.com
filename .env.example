# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONTACT_WEBHOOK_URL: (Server-only secret)
# HTTPS destination URL (e.g. Slack incoming webhook, CRM intake, Zapier, Make, or custom API)
# to which submitted workflow review requests are forwarded.
# NEVER expose this variable with a VITE_ prefix.
CONTACT_WEBHOOK_URL=""

# BOOKING_WEBHOOK_URL: (Server-only secret)
# HTTPS destination URL to forward call bookings with Kentley (dispatched to wongkentley@gmail.com).
BOOKING_WEBHOOK_URL=""

# VITE_SITE_DOMAIN: Public domain name for the agency website.
# Defaults to droppflowwsystems.com if unset.
VITE_SITE_DOMAIN="droppflowwsystems.com"

# VITE_SITE_URL: Canonical base URL for structured data and metadata.
VITE_SITE_URL="https://droppflowwsystems.com"

# VITE_BOOKING_URL: Optional external calendar link (e.g., Cal.com or Calendly)
# for direct scheduling. If left empty, direct email / review submission is used.
VITE_BOOKING_URL=""

# VITE_CONTACT_EMAIL: Optional direct contact email address.
# If left empty, no unverified email address is displayed.
VITE_CONTACT_EMAIL=""
